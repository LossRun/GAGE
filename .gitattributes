# Map .gage files to a recognized green-badged language
*.gage linguist-language=C#
*.gage linguist-detectable=true

# Keep helper scripts and test suites out of the language calculation
test_runner.py linguist-vendored
tests_suite/** linguist-vendored
install.ps1 linguist-vendored
gage-setup.sh linguist-vendored
fix_codegen.py linguist-vendored
