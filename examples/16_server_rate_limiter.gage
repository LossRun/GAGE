let max_tokens = 10;
let current_tokens = 4;
let refill_rate = 2;
let requests_received = 6;
current_tokens = current_tokens + refill_rate;
if (current_tokens > max_tokens) {
    current_tokens = max_tokens;
}
if (requests_received <= current_tokens) {
    current_tokens = current_tokens - requests_received;
    println("200 OK");
} else {
    println("429 Too Many Requests");
}
