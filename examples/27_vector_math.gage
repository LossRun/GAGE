// 27_vector_math.gage
let forward = vec3(0.0, 0.0, 1.0);
let up = vec3(0.0, 1.0, 0.0);
let right = cross(forward, up);

println("=== Vector Math ===");
println(right);

let v = vec3(3.0, 4.0, 0.0);
let len = length(v);
print("Length of (3, 4, 0): ");
println(len);

let d = dot(forward, up);
print("dot(forward, up): ");
println(d);
