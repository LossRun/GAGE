let max_hp = 100.0;
let current_hp = 100.0;
let shield = 50.0;
let incoming_damage = 75.0;
println("=== Damage Calculation ===");
if (incoming_damage <= shield) {
    shield = shield - incoming_damage;
} else {
    let rem = incoming_damage - shield;
    shield = 0.0;
    current_hp = current_hp - rem;
}
println(shield);
println(current_hp);
