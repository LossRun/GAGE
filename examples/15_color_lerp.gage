// Project 15: RGBA Color Interpolation (Lerp)
let red_color = vec4(1.0, 0.0, 0.0, 1.0);
let blue_color = vec4(0.0, 0.0, 1.0, 1.0);
let alpha_t = 0.5;

let delta = blue_color - red_color;
let purple = red_color + (delta * alpha_t);

println("=== RGBA Color Gradient Lerp (50%) ===");
println(purple);
