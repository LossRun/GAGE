// Full Wireframe 3D Rotating Cube Demo
let angle = 0.0;
let frame = 0;

while (frame < 30) {
    clear_screen();
    println("╔════════════════════════════════════════════════════╗");
    println("║    ⚡ GAGE 3D REAL-TIME WIREFRAME ENGINE (mat4)    ║");
    println("╚════════════════════════════════════════════════════╝");

    // Dual-axis rotation: Rotate around Y, scale slightly for terminal aspect ratio
    let rot = mat4_rotate_y(angle);

    // 8 Cube Vertices in local coordinates
    let v0 = mat4_transform_vec3(rot, vec3(-1.2, -1.2, -1.2));
    let v1 = mat4_transform_vec3(rot, vec3( 1.2, -1.2, -1.2));
    let v2 = mat4_transform_vec3(rot, vec3( 1.2,  1.2, -1.2));
    let v3 = mat4_transform_vec3(rot, vec3(-1.2,  1.2, -1.2));
    let v4 = mat4_transform_vec3(rot, vec3(-1.2, -1.2,  1.2));
    let v5 = mat4_transform_vec3(rot, vec3( 1.2, -1.2,  1.2));
    let v6 = mat4_transform_vec3(rot, vec3( 1.2,  1.2,  1.2));
    let v7 = mat4_transform_vec3(rot, vec3(-1.2,  1.2,  1.2));

    // Perspective projection onto a large 46x20 screen buffer
    let p0x = floor((v0.x / (v0.z + 3.5)) * 32.0 + 23.0);
    let p0y = floor((v0.y / (v0.z + 3.5)) * 16.0 + 10.0);
    let p1x = floor((v1.x / (v1.z + 3.5)) * 32.0 + 23.0);
    let p1y = floor((v1.y / (v1.z + 3.5)) * 16.0 + 10.0);
    let p2x = floor((v2.x / (v2.z + 3.5)) * 32.0 + 23.0);
    let p2y = floor((v2.y / (v2.z + 3.5)) * 16.0 + 10.0);
    let p3x = floor((v3.x / (v3.z + 3.5)) * 32.0 + 23.0);
    let p3y = floor((v3.y / (v3.z + 3.5)) * 16.0 + 10.0);

    let p4x = floor((v4.x / (v4.z + 3.5)) * 32.0 + 23.0);
    let p4y = floor((v4.y / (v4.z + 3.5)) * 16.0 + 10.0);
    let p5x = floor((v5.x / (v5.z + 3.5)) * 32.0 + 23.0);
    let p5y = floor((v5.y / (v5.z + 3.5)) * 16.0 + 10.0);
    let p6x = floor((v6.x / (v6.z + 3.5)) * 32.0 + 23.0);
    let p6y = floor((v6.y / (v6.z + 3.5)) * 16.0 + 10.0);
    let p7x = floor((v7.x / (v7.z + 3.5)) * 32.0 + 23.0);
    let p7y = floor((v7.y / (v7.z + 3.5)) * 16.0 + 10.0);

    // Rasterize 46x20 ASCII frame
    let y = 0.0;
    while (y < 21.0) {
        let x = 0.0;
        while (x < 47.0) {
            let ch = 0; // 0: space, 1: edge, 2: vertex

            // Check Vertices
            if (x == p0x && y == p0y) { ch = 2; }
            if (x == p1x && y == p1y) { ch = 2; }
            if (x == p2x && y == p2y) { ch = 2; }
            if (x == p3x && y == p3y) { ch = 2; }
            if (x == p4x && y == p4y) { ch = 2; }
            if (x == p5x && y == p5y) { ch = 2; }
            if (x == p6x && y == p6y) { ch = 2; }
            if (x == p7x && y == p7y) { ch = 2; }

            // Check interpolated edge midpoints for wireframe structure
            if (ch == 0) {
                if (x == floor((p0x + p1x) / 2.0) && y == floor((p0y + p1y) / 2.0)) { ch = 1; }
                if (x == floor((p1x + p2x) / 2.0) && y == floor((p1y + p2y) / 2.0)) { ch = 1; }
                if (x == floor((p2x + p3x) / 2.0) && y == floor((p2y + p3y) / 2.0)) { ch = 1; }
                if (x == floor((p3x + p0x) / 2.0) && y == floor((p3y + p0y) / 2.0)) { ch = 1; }

                if (x == floor((p4x + p5x) / 2.0) && y == floor((p4y + p5y) / 2.0)) { ch = 1; }
                if (x == floor((p5x + p6x) / 2.0) && y == floor((p5y + p6y) / 2.0)) { ch = 1; }
                if (x == floor((p6x + p7x) / 2.0) && y == floor((p6y + p7y) / 2.0)) { ch = 1; }
                if (x == floor((p7x + p4x) / 2.0) && y == floor((p7y + p4y) / 2.0)) { ch = 1; }

                if (x == floor((p0x + p4x) / 2.0) && y == floor((p0y + p4y) / 2.0)) { ch = 1; }
                if (x == floor((p1x + p5x) / 2.0) && y == floor((p1y + p5y) / 2.0)) { ch = 1; }
                if (x == floor((p2x + p6x) / 2.0) && y == floor((p2y + p6y) / 2.0)) { ch = 1; }
                if (x == floor((p3x + p7x) / 2.0) && y == floor((p3y + p7y) / 2.0)) { ch = 1; }
            }

            if (ch == 2) {
                print("█");
            } else {
                if (ch == 1) {
                    print("·");
                } else {
                    print(" ");
                }
            }
            x = x + 1.0;
        }
        println("");
        y = y + 1.0;
    }

    angle = angle + 0.12;
    frame = frame + 1;
    gage_sleep(33.0);
}
