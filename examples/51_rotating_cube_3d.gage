// High-Detail 30-Second 3D Multi-Axis Wireframe Cube
// Uses continuous segment distance rasterization for gapless lines

fn edge_dist_sq(px, py, x1, y1, x2, y2) {
    let dx = x2 - x1;
    let dy = y2 - y1;
    let lsq = dx * dx + dy * dy;
    if (lsq < 0.05) {
        return 999.0;
    }
    let t = ((px - x1) * dx + (py - y1) * dy) / lsq;
    let tc = clamp(t, 0.0, 1.0);
    let cx = x1 + tc * dx;
    let cy = y1 + tc * dy;
    let ex = px - cx;
    let ey = (py - cy) * 2.0;
    return ex * ex + ey * ey;
}

let frame = 0;
let total_frames = 800; // ~30 seconds of real-time animation

while (frame < total_frames) {
    clear_screen();
    println("╔══════════════════════════════════════════════════════════╗");
    println("║    ⚡ GAGE 3D REAL-TIME MULTI-AXIS ENGINE (mat4 + SIMD)   ║");
    println("╚══════════════════════════════════════════════════════════╝");

    let sec = floor(frame * 0.038);
    print("  Time: ");
    print(sec);
    print("s / 30s | Frame: ");
    print(frame);
    print(" / ");
    println(total_frames);

    // Continuous 3-axis tumbling with sine/cosine variation
    let pitch = frame * 0.055 + sin(frame * 0.02) * 0.35;
    let yaw   = frame * 0.085;
    let roll  = frame * 0.035 + cos(frame * 0.015) * 0.25;

    let cp = cos(pitch);
    let sp = sin(pitch);
    let cr = cos(roll);
    let sr = sin(roll);

    let rot_y = mat4_rotate_y(yaw);

    // Cube half-size
    let sz = 1.35;

    // V0: (-sz, -sz, -sz)
    let y0_p = -sz * cp - (-sz) * sp;
    let z0_p = -sz * sp + (-sz) * cp;
    let x0_r = -sz * cr - y0_p * sr;
    let y0_r = -sz * sr + y0_p * cr;
    let v0 = mat4_transform_vec3(rot_y, vec3(x0_r, y0_r, z0_p));

    // V1: ( sz, -sz, -sz)
    let y1_p = -sz * cp - (-sz) * sp;
    let z1_p = -sz * sp + (-sz) * cp;
    let x1_r =  sz * cr - y1_p * sr;
    let y1_r =  sz * sr + y1_p * cr;
    let v1 = mat4_transform_vec3(rot_y, vec3(x1_r, y1_r, z1_p));

    // V2: ( sz,  sz, -sz)
    let y2_p =  sz * cp - (-sz) * sp;
    let z2_p =  sz * sp + (-sz) * cp;
    let x2_r =  sz * cr - y2_p * sr;
    let y2_r =  sz * sr + y2_p * cr;
    let v2 = mat4_transform_vec3(rot_y, vec3(x2_r, y2_r, z2_p));

    // V3: (-sz,  sz, -sz)
    let y3_p =  sz * cp - (-sz) * sp;
    let z3_p =  sz * sp + (-sz) * cp;
    let x3_r = -sz * cr - y3_p * sr;
    let y3_r = -sz * sr + y3_p * cr;
    let v3 = mat4_transform_vec3(rot_y, vec3(x3_r, y3_r, z3_p));

    // V4: (-sz, -sz,  sz)
    let y4_p = -sz * cp - ( sz) * sp;
    let z4_p = -sz * sp + ( sz) * cp;
    let x4_r = -sz * cr - y4_p * sr;
    let y4_r = -sz * sr + y4_p * cr;
    let v4 = mat4_transform_vec3(rot_y, vec3(x4_r, y4_r, z4_p));

    // V5: ( sz, -sz,  sz)
    let y5_p = -sz * cp - ( sz) * sp;
    let z5_p = -sz * sp + ( sz) * cp;
    let x5_r =  sz * cr - y5_p * sr;
    let y5_r =  sz * sr + y5_p * cr;
    let v5 = mat4_transform_vec3(rot_y, vec3(x5_r, y5_r, z5_p));

    // V6: ( sz,  sz,  sz)
    let y6_p =  sz * cp - ( sz) * sp;
    let z6_p =  sz * sp + ( sz) * cp;
    let x6_r =  sz * cr - y6_p * sr;
    let y6_r =  sz * sr + y6_p * cr;
    let v6 = mat4_transform_vec3(rot_y, vec3(x6_r, y6_r, z6_p));

    // V7: (-sz,  sz,  sz)
    let y7_p =  sz * cp - ( sz) * sp;
    let z7_p =  sz * sp + ( sz) * cp;
    let x7_r = -sz * cr - y7_p * sr;
    let y7_r = -sz * sr + y7_p * cr;
    let v7 = mat4_transform_vec3(rot_y, vec3(x7_r, y7_r, z7_p));

    // Perspective projection onto 50x22 screen grid
    let cam_dist = 4.2;
    let p0x = floor((v0.x / (v0.z + cam_dist)) * 38.0 + 25.0);
    let p0y = floor((v0.y / (v0.z + cam_dist)) * 18.0 + 11.0);
    let p1x = floor((v1.x / (v1.z + cam_dist)) * 38.0 + 25.0);
    let p1y = floor((v1.y / (v1.z + cam_dist)) * 18.0 + 11.0);
    let p2x = floor((v2.x / (v2.z + cam_dist)) * 38.0 + 25.0);
    let p2y = floor((v2.y / (v2.z + cam_dist)) * 18.0 + 11.0);
    let p3x = floor((v3.x / (v3.z + cam_dist)) * 38.0 + 25.0);
    let p3y = floor((v3.y / (v3.z + cam_dist)) * 18.0 + 11.0);

    let p4x = floor((v4.x / (v4.z + cam_dist)) * 38.0 + 25.0);
    let p4y = floor((v4.y / (v4.z + cam_dist)) * 18.0 + 11.0);
    let p5x = floor((v5.x / (v5.z + cam_dist)) * 38.0 + 25.0);
    let p5y = floor((v5.y / (v5.z + cam_dist)) * 18.0 + 11.0);
    let p6x = floor((v6.x / (v6.z + cam_dist)) * 38.0 + 25.0);
    let p6y = floor((v6.y / (v6.z + cam_dist)) * 18.0 + 11.0);
    let p7x = floor((v7.x / (v7.z + cam_dist)) * 38.0 + 25.0);
    let p7y = floor((v7.y / (v7.z + cam_dist)) * 18.0 + 11.0);

    // Rasterize 51x23 screen frame with continuous edges
    let y = 0.0;
    while (y < 23.0) {
        let x = 0.0;
        while (x < 51.0) {
            let hit = 0;
            let is_front = 0;

            // Check 8 Vertices
            if ((x - p0x)*(x - p0x) + (y - p0y)*(y - p0y)*4.0 < 2.0) { hit = 2; }
            if (hit == 0 && (x - p1x)*(x - p1x) + (y - p1y)*(y - p1y)*4.0 < 2.0) { hit = 2; }
            if (hit == 0 && (x - p2x)*(x - p2x) + (y - p2y)*(y - p2y)*4.0 < 2.0) { hit = 2; }
            if (hit == 0 && (x - p3x)*(x - p3x) + (y - p3y)*(y - p3y)*4.0 < 2.0) { hit = 2; }
            if (hit == 0 && (x - p4x)*(x - p4x) + (y - p4y)*(y - p4y)*4.0 < 2.0) { hit = 2; }
            if (hit == 0 && (x - p5x)*(x - p5x) + (y - p5y)*(y - p5y)*4.0 < 2.0) { hit = 2; }
            if (hit == 0 && (x - p6x)*(x - p6x) + (y - p6y)*(y - p6y)*4.0 < 2.0) { hit = 2; }
            if (hit == 0 && (x - p7x)*(x - p7x) + (y - p7y)*(y - p7y)*4.0 < 2.0) { hit = 2; }

            // Continuous Edge Distance Checks (12 Wireframe Edges)
            if (hit == 0) {
                // Back Face
                if (edge_dist_sq(x, y, p0x, p0y, p1x, p1y) < 1.3) { hit = 1; if (v0.z + v1.z < 0.0) { is_front = 1; } }
                if (hit == 0 && edge_dist_sq(x, y, p1x, p1y, p2x, p2y) < 1.3) { hit = 1; if (v1.z + v2.z < 0.0) { is_front = 1; } }
                if (hit == 0 && edge_dist_sq(x, y, p2x, p2y, p3x, p3y) < 1.3) { hit = 1; if (v2.z + v3.z < 0.0) { is_front = 1; } }
                if (hit == 0 && edge_dist_sq(x, y, p3x, p3y, p0x, p0y) < 1.3) { hit = 1; if (v3.z + v0.z < 0.0) { is_front = 1; } }

                // Front Face
                if (hit == 0 && edge_dist_sq(x, y, p4x, p4y, p5x, p5y) < 1.3) { hit = 1; if (v4.z + v5.z < 0.0) { is_front = 1; } }
                if (hit == 0 && edge_dist_sq(x, y, p5x, p5y, p6x, p6y) < 1.3) { hit = 1; if (v5.z + v6.z < 0.0) { is_front = 1; } }
                if (hit == 0 && edge_dist_sq(x, y, p6x, p6y, p7x, p7y) < 1.3) { hit = 1; if (v6.z + v7.z < 0.0) { is_front = 1; } }
                if (hit == 0 && edge_dist_sq(x, y, p7x, p7y, p4x, p4y) < 1.3) { hit = 1; if (v7.z + v4.z < 0.0) { is_front = 1; } }

                // Connecting Pillars
                if (hit == 0 && edge_dist_sq(x, y, p0x, p0y, p4x, p4y) < 1.3) { hit = 1; if (v0.z + v4.z < 0.0) { is_front = 1; } }
                if (hit == 0 && edge_dist_sq(x, y, p1x, p1y, p5x, p5y) < 1.3) { hit = 1; if (v1.z + v5.z < 0.0) { is_front = 1; } }
                if (hit == 0 && edge_dist_sq(x, y, p2x, p2y, p6x, p6y) < 1.3) { hit = 1; if (v2.z + v6.z < 0.0) { is_front = 1; } }
                if (hit == 0 && edge_dist_sq(x, y, p3x, p3y, p7x, p7y) < 1.3) { hit = 1; if (v3.z + v7.z < 0.0) { is_front = 1; } }
            }

            if (hit == 2) {
                print("@");
            } else {
                if (hit == 1) {
                    if (is_front == 1) {
                        print("#");
                    } else {
                        print(".");
                    }
                } else {
                    print(" ");
                }
            }
            x = x + 1.0;
        }
        println("");
        y = y + 1.0;
    }

    frame = frame + 1;
    gage_sleep(35.0);
}
