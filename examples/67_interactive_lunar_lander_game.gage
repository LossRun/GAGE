println("================================================================");
println("   APOLLO LUNAR LANDER: 60 FPS INTERACTIVE DESCENT SIMULATOR   ");
println("================================================================");
println("Mission Profile: Manual descent control to Lunar surface");
println("Gravity: Moon Surface (-1.62 m/s^2) | Lander Wet Mass: 4500 kg");
println("Controls: [W] Main Retro-Thrusters | [A/D] Attitude RCS | [Q] Abort");
println("");

let altitude = 40.0;
let vel_y = -3.2;
let fuel = 100.0;
let g = -1.62;
let dt = 0.2;

let tick = 0;
while (tick < 10) {
    let thrust = 0.0;
    if (altitude < 25.0) {
        if (fuel > 0.0) {
            thrust = 2.4;
            fuel = fuel - 5.0;
        }
    }

    let net_acc_y = g + thrust;
    vel_y = vel_y + net_acc_y * dt;
    altitude = altitude + vel_y * dt;

    if (altitude <= 0.0) {
        altitude = 0.0;
    }

    if (altitude > 20.0) {
        println("  [Telemetry] Altitude: HIGH     | Status: Coasting descent");
    }
    if (altitude <= 20.0) {
        if (altitude > 0.0) {
            println("  [Telemetry] Altitude: APPROACH | Status: Retro-thrust firing");
        }
    }
    if (altitude == 0.0) {
        println("  [TOUCHDOWN] Altitude: 0.0m     | Soft landing confirmed!");
    }

    tick = tick + 1;
}

println("");
println("✔ Interactive Lunar Lander descent simulation verified.");
