// Interactive Fibonacci Sequence Generator
fn fib(n) {
    if (n <= 1) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn main() {
    println("=== GAGE Interactive Fibonacci Calculator ===");
    println("Enter term N to calculate (e.g. 10):");
    let n = gage_input_int();
    let res = fib(n);
    println("Result:");
    println(res);
}
