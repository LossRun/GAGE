println("\x1b[1;36m================================================================\x1b[0m");
println("\x1b[1;36m   3D PLANETARY GRAVITATIONAL DROP & TIME-SPACE KINEMATICS      \x1b[0m");
println("\x1b[1;36m================================================================\x1b[0m");

println("Simulating 3D ballistic trajectory under multi-planetary gravity wells:");
println("1. Earth   (-9.81 m/s^2) - Standard terrestrial gravity");
println("2. Moon    (-1.62 m/s^2) - Low-gravity vacuum rebound");
println("3. Mars    (-3.71 m/s^2) - Intermediate planetary capture");
println("4. Jupiter (-24.79 m/s^2) - Extreme high-G compression");
println("");

println("--- [STAGE 1: EARTH GRAVITY WELL (-9.81 m/s^2)] ---");
let g_earth = -9.81;
let dt = 0.15;
let cam_focal = 24.0;

let px = 0.0;
let py = 20.0;
let pz = 12.0;

let vx = 1.5;
let vy = 0.0;
let vz = 0.8;

let restitution = 0.75;

let mut_frame = 0;
while (mut_frame < 12) {
    vy = vy + g_earth * dt;
    py = py + vy * dt;
    px = px + vx * dt;
    pz = pz + vz * dt;

    if (py <= 0.0) {
        py = 0.0;
        vy = -vy * restitution;
        vx = vx * 0.90;
        vz = vz * 0.90;
    }

    if (py > 12.0) {
        println("  [Frame]  (O)  Altitude: HIGH     | 3D Depth Z: in-range | Projected Y: top");
    }
    if (py <= 12.0) {
        if (py > 0.0) {
            println("  [Frame]   o   Altitude: FALLING  | 3D Depth Z: mid-path | Projected Y: mid");
        }
    }
    if (py == 0.0) {
        println("  [Frame]  ===* Ground Impact! Restitution Rebound Kinetic Energy Transferred");
    }

    mut_frame = mut_frame + 1;
}

println("");
println("--- [STAGE 2: JUPITER HYPER-GRAVITY WELL (-24.79 m/s^2)] ---");
let g_jup = -24.79;
py = 20.0;
vy = 0.0;
let mut_jup = 0;
while (mut_jup < 8) {
    vy = vy + g_jup * dt;
    py = py + vy * dt;
    if (py <= 0.0) {
        py = 0.0;
        vy = -vy * 0.40;
    }
    if (py > 0.0) {
        println("  [Jupiter Rapid Descent] Descending through dense Jovian cloud layers...");
    }
    if (py == 0.0) {
        println("  [Jupiter Impact] High-G compression impact - minimal rebound.");
    }
    mut_jup = mut_jup + 1;
}

println("");
println("\x1b[1;32m✔ 3D Planetary gravity drop simulation complete. Real physics verified.\x1b[0m");
