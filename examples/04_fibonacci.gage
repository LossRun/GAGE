// Interactive Fibonacci Calculator (O(n) linear performance)
fn fib(n) {
    if (n <= 1) {
        return n;
    }
    let a = 0;
    let b = 1;
    let i = 2;
    while (i <= n) {
        let next_val = a + b;
        a = b;
        b = next_val;
        i = i + 1;
    }
    return b;
}

println("=== GAGE Interactive Fibonacci Calculator ===");
println("Enter term N to calculate (e.g. 10 or 66):");
let n = gage_input_int();
let res = fib(n);
println("Result:");
println(res);
