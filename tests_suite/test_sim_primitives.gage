let n = vec3(0.0, 1.0, 0.0); let v = vec3(5.0, -5.0, 0.0); let ref = reflect(v, n); let d = distance(vec3(0.0, 0.0, 0.0), vec3(3.0, 4.0, 0.0)); let l = lerp(0.0, 100.0, 0.5); let c = clamp(150.0, 0.0, 100.0); if (ref.y > 4.9) { if (ref.y < 5.1) { if (d > 4.9) { if (d < 5.1) { if (l == 50.0) { if (c == 100.0) { println("PASS"); } } } } } }
